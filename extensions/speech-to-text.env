ALLOWED_EVENT_TYPES=firebase.extensions.storage-transcribe-audio.v1.complete
ENABLE_AUTOMATIC_PUNCTUATION=true
EVENTARC_CHANNEL=projects/${param:PROJECT_ID}/locations/us-central1/channels/firebase
EXTENSION_BUCKET=ai-mock-interview-a7198.firebasestorage.app
firebaseextensions.v1beta.function/ingressSettings=ALLOW_ALL
firebaseextensions.v1beta.function/minInstances=1000
firebaseextensions.v1beta.function/timeoutSeconds=540
firebaseextensions.v1beta.function/vpcConnectorEgressSettings=VPC_CONNECTOR_EGRESS_SETTINGS_UNSPECIFIED
LANGUAGE_CODE=en-IN
LOCATION=us-central1
MODEL=latestlong
OUTPUT_STORAGE_PATH=ai-mock-interview-a7198.appspot.com